// Agregar al final de /etc/named.conf de slackware. Archivos de zona en /etc/DNS (directory del options).

zone "juan.com.co" IN {
	type slave;
	masters { 192.168.82.11; };
	file "juan.com.co.slave";
};

zone "camilo.org.jp" IN {
	type master;
	file "camilo.org.jp.hosts";
	allow-transfer { 192.168.82.11; };
	notify yes;
};
